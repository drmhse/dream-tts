@startuml qwen3tts-speedup
title <b>qwen3tts: what buys the speed</b>\nshipped RTF 0.260 = 3.9x realtime   |   5x = RTF 0.200

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam titleFontSize 15
skinparam roundCorner 8
skinparam nodesep 45
skinparam ranksep 30
skinparam ArrowColor #666666
skinparam ArrowFontSize 11
skinparam rectangle {
  BorderColor #6B7A88
  BackgroundColor #EDF1F5
}
skinparam noteFontSize 12

rectangle "text -> segments" as SEG
rectangle "ICL prompt\nref codes + spk" as PROMPT
rectangle "**scheduler**" as SCHED #DDF3E0
rectangle "**talker**\n0.187  (72%)" as TALKER #DDF3E0
rectangle "**codec**\n0.073  (28%)" as CODEC #DDF3E0
rectangle "24 kHz WAV\n**0.260 = 3.9x**" as WAV #D6E9F8

SEG --> PROMPT
PROMPT --> SCHED
SCHED --> TALKER : "24 lanes"
TALKER --> CODEC : "[T, 16] codes"
CODEC --> WAV

note right of SCHED #DDF3E0
  shape buckets
  length sort
  chunk to 24
end note

note right of TALKER #DDF3E0
  f16, not q8_0      <b>7.4x</b> vs 1.1x
  batched decode     24 lanes
  in-place KV        -112 MB/step
  folded tables      -126 MB/frame
  512-frame cap
end note

note right of CODEC #DDF3E0
  one call per utterance
  300 + 25 frame chunks
  fused NLC kernels
end note

note left of TALKER #FDEBD0
  <i>to reach 0.200</i>
  lane refill
  batch 32-48
end note

note left of CODEC #FDEBD0
  <i>to reach 0.200</i>
  torch-parity kernels
end note

note bottom of WAV #FFFDF0
  |= |= talker |= codec |= |
  | shipped | 0.187 | 0.073 | <b>3.9x</b> |
  | target | 0.145 | 0.055 | <b>5.0x</b> |
  green measured, amber projected
end note

@enduml
